# Copy this file to .env.local and fill in the values.
# Never commit .env.local. Add the same values in Vercel → Project → Settings → Environment Variables.

# Login (Phase 2): the only email allowed to sign in
ALLOWED_EMAIL=

# Supabase (Phase 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# API for Claude's scheduled tasks (Phases 8 + 6): POST /api/log, GET /api/summary, POST /api/money.
# A long random string (make one with: openssl rand -hex 32). Empty = the API answers 503 and the app works as usual.
# The API writes with SUPABASE_SERVICE_ROLE_KEY, so set that too. See docs/API.md.
API_TOKEN=

# Share link for /progress (Phase 9): a long random string. Anyone with the link sees the Winter Arc card.
# The public card is read with SUPABASE_SERVICE_ROLE_KEY (Supabase secret key), so set both.
SHARE_TOKEN=

