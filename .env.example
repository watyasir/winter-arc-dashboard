# Copy this file to .env.local and fill in the values.
# Never commit .env.local. Add the same values in Vercel → Project → Settings → Environment Variables.

# Login (Phase 2): the only email allowed to sign in
ALLOWED_EMAIL=

# Supabase (Phase 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheets, read-only (Phase 6)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
FINANCE_SHEET_ID=

# Logging API for scheduled tasks (Phase 8)
LOG_API_TOKEN=

# Gmail OAuth (Phase 8b)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Instinct read-only page + digest (Phase 8c)
INSTINCT_PAGE_TOKEN=
INSTINCT_EMAIL=
